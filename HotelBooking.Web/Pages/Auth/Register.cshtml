@page
@model HotelBooking.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-4 p-4">
                
                <h2 class="fw-bold text-center mb-4">Welcome Back</h2>
                
                @* show error if login failed *@
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">FullName</label>
                        <input asp-for="RegisterDto.FullName" 
                               class="form-control" 
                               placeholder="Enter your name"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="RegisterDto.Email" 
                               class="form-control" 
                               placeholder="Enter your email"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="RegisterDto.Password" 
                               type="password"
                               class="form-control" 
                               placeholder="Enter your password"/>
                    </div>
                    <button type="submit" 
                            class="btn btn-primary w-100 py-2 mt-2">
                        Register
                    </button>
                </form>

                <p class="text-center mt-3 text-muted">
                    Already have an account? 
                    <a asp-page="/Auth/Login">Login here</a>
                </p>

            </div>
        </div>
    </div>
</div>