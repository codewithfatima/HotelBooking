@page
@model HotelBooking.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}



 <div class="container py-5">
     <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold" style="color: #00126a;">
            <i class="bi bi-calendar-check me-2"></i>
            My Bookings
        </h2>
        <p class="text-secondary">
            View your reservations and booking details.
        </p>
    </div>

     @if (Model.Bookings.Any())
    {
        <div class="row g-4">
            @foreach(var booking in Model.Bookings)
            {
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <!-- Card Header -->
                        <div class="card-header bg-white border-0
                                    p-4 pb-2 rounded-top-4">

                            <div class="d-flex justify-content-between
                                        align-items-center">
                            <div>
                                 <small class="text-secondary">
                                        Booking Reference
                                    </small>

                                     <h5 class="fw-bold mb-0"
                                        style="color: #00126a;">
                                        #@booking.Id
                                    </h5>
                            </div>
                                @{
                                    var statusText = booking.Status == 0 ? "Pending"
                                            : booking.Status == 1 ? "Confrimed"
                                            : "Cancelled";

                                    var statusColor = booking.Status == 0 ? "bg-warning text-dark"
                                                     :booking.Status == 1 ? "bg-success text-white"
                                                     : "bg-danger text-white";
                                 }

                        
                             <span class="badge @statusColor rounded-pill px-3 py-2">
                                   @statusText
                             </span> 
                        </div>
                    </div>

                      <!-- Booking Details -->
                        <div class="card-body p-4">

                            <div class="p-3 rounded-3 mb-4"
                                 style="background-color: #f5f7fc;">

                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-secondary">
                                        <i class="bi bi-door-open me-2"></i>
                                        Room
                                    </span>
                               <strong>@booking.RoomId</strong>
                        </div>

                         <div class="d-flex justify-content-between mb-3">
                                    <span class="text-secondary">
                                           <i class="bi bi-calendar-event me-2"></i>
                                        Check-in
                                    </span>
                                    <strong>@booking.CheckInDate.ToString("dd / MM / yyyy")</strong>
                        </div>

                          <div class="d-flex justify-content-between mb-3">
                                    <span class="text-secondary">
                                           <i class="bi bi-calendar-check me-2"></i>
                                        Check-Out-Date
                                    </span>
                                    <strong>@booking.CheckOutDate.ToString("dd / MM / yyyy")</strong>
                        </div>
                        </div>

                          <div class="d-flex justify-content-between mb-3">
                                    <span class="text-secondary">
                                          Price per night
                                    </span>
                                    <strong>@booking.PricePerNight.ToString("0.000") KWD</strong>
                        </div>

                          <hr />

                          <div class="d-flex justify-content-between mb-3">
                                    <span class="fw-bold">
                                    Total Price
                                </span>

                                <h4 class="fw-bold mb-0"
                                    style="color: #00126a;">
                                    @booking.TotalPrice.ToString("0.000") KWD
                                </h4>
                        </div>

                        <div class="mt-3">
                                <small class="text-secondary">
                                    Booked on
                                    @booking.CreatedAt.ToString("dd / MMM / yyyy")
                                </small>
                         </div>
                </div>
        </div>
        </div>
    }

    </div>
    }
    else{
        <!-- Empty State -->
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-secondary"></i>

            <h4 class="fw-bold mt-3">No bookings yet</h4>

            <p class="text-secondary">
                You haven't made any reservations. Find a room for your next stay!
            </p>

            <a asp-page="/Hotels/Index"
               class="btn btn-primary px-4 py-2"
               style="background-color: #00126a; border: none;">
                <i class="bi bi-search me-2"></i>
                Explore Hotels
            </a>
        </div>
    }

</div> 
