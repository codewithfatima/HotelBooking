@page
@model HotelBooking.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a Room";

}


<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-0 rounded-4 p-4">
                <h2 class="fw-bold mb-4" style="color: #00126a;">
                    Book a Room
                </h2>

        @* show room info  *@
            <div class="mb-4 p-3 rounded-3" style="background-color: #f5f7fc;">
                <h5>@Model.Room.RoomType - Room @Model.Room.RoomNumber</h5>
                <p class="mb-1">Capacity: @Model.Room.Capacity guests</p>
                <p class="mb-0 fw-bold"> @Model.Room.Price KWD per night</p>
        </div>

        @* show error  *@
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

               <form method="post">
                    <input type="hidden" asp-for="RoomId" />

                    <div class="mb-3">
                        <label asp-for="CreateBooking.CheckInDate"
                               class="form-label">Check-in Date</label>

                        <input asp-for="CreateBooking.CheckInDate"
                               type="date"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="CreateBooking.CheckInDate"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateBooking.CheckOutDate"
                               class="form-label">Check-out Date</label>

                        <input asp-for="CreateBooking.CheckOutDate"
                               type="date"
                               class="form-control"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="CreateBooking.CheckOutDate"
                              class="text-danger"></span>
                    </div>

                <button type="submit" class="btn w-100 py-2 fw-bold" 
                style="background-color: #00126a; color: white;">
                    Confrim Booking
                </button>
              </form>

        </div>
    </div>
</div>
</div>