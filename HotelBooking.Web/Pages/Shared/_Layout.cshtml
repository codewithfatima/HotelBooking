
@{
    var token = Context.Session.GetString("token");
    var username = Context.Session.GetString("username");
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBooking.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooking.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark  border-bottom box-shadow mb-3"
             style=" background-color: #04175c;">
           @* Navheading *@
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">🏨 HotelBooking</a>

                @* toggle btn *@
                <button class="navbar-toggler" type="button" 
                data-bs-toggle="collapse"
                data-bs-target=".navbar-collapse" 
                aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
                </button>
                @* NAvLinks *@
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item text-white">
                            <a class="nav-link text-white" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white"  asp-page="/Hotels/Index">Hotels</a>
                        </li>
                      
                    </ul>

                    @* rightside navitems *@
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if(!string.IsNullOrEmpty(token))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white">@username</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Auth/Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            
                        @* logina nd register btn  *@

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Auth/Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-warning ms-2" asp-page="/Auth/Register">Register</a>
                            </li>

                        }
                   </ul>
                  
                  
                </div>
            </div>
        </nav>
    </header>

    @* Main content *@
    @* <div class="container">
    </div> *@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    @* footer *@
    <footer style="background-color: #04175c;" class="text-white py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1 fw-bold">🏨 HotelBooking</p>
            <p class="text-white-50 small">
                &copy; 2026 HotelBooking. All rights reserved.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>