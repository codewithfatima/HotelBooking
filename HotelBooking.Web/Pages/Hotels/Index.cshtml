<script>

    function toggleFavorite(button, event) {
        event.preventDefault();
        event.stopPropagation();

        const icon = button.querySelector("i");
        const isOutline = icon.classList.contains("bi-heart");

        icon.classList.toggle("bi-heart", !isOutline);
        icon.classList.toggle("bi-heart-fill", isOutline);

        button.style.color = isOutline ? "#dc3545" : "#6c757d";
    }

</script>