@page
@model HotelBooking.Web.Pages.Hotels.IndexModel

@{
    ViewData["Title"] = "Hotels";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Find Your Perfect Hotel</h1>
        <p class="lead mb-4">Discover comfortable stays for your next trip.</p>
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card p-3 shadow">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input type="date" class="form-control" placeholder="Check-in" />
                        </div>
                        <div class="col-md-4">
                            <input type="date" class="form-control" placeholder="Check-out" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-warning w-100 fw-bold">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





<section class="hotels-section py-5">
    <div class="container">

        <!-- Section Header -->
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-end mb-5 gap-3">

            <div>
                <span class="section-label">DISCOVER YOUR NEXT STAY</span>
                <h1 class="hotels-heading mt-2 mb-2">
                    Available <span>Hotels</span>
                </h1>
                <p class="text-secondary mb-0">
                    Find the perfect place to relax, explore, and unwind.
                </p>
            </div>

            <div class="hotel-count">
                <i class="bi bi-buildings me-2"></i>
                <strong>@Model.Hotels.Count()</strong> properties available
            </div>

        </div>

        <!-- Hotel Grid -->
        <div class="row g-4">

            @foreach (var hotel in Model.Hotels)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <article class="hotel-card h-100">

                        <!-- Hotel Image -->
                        <div class="hotel-image-wrapper">
                            <div class="hotel-image-container position-relative">

                                <a asp-page="/Hotels/Details"
                                   asp-route-hotelId="@hotel.Id">
                                    <img src="@hotel.Image"
                                         class="hotel-image"
                                         alt="@hotel.Name"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.src='/images/default-hotel.jpg';" />
                                </a>
                                <button type="button"
                                        class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow d-flex align-items-center justify-content-center"
                                        style="width: 42px; height: 42px; z-index: 2;"
                                        aria-label="Add to favorites"
                                        onclick="toggleFavorite(this, event)">
                                    <i class="bi bi-heart fs-5"></i>
                                </button>
                           </div>
                            <div class="image-overlay"></div>

                            <span class="hotel-tag">
                                <i class="bi bi-patch-check-fill me-1"></i>
                                Great Stay
                            </span>

                            <div class="image-caption">
                                <i class="bi bi-geo-alt-fill me-1"></i>
                                Featured Property
                            </div>

                        </div>

                        <!-- Hotel Details -->
                        <div class="hotel-content">

                            <div class="d-flex justify-content-between
                                        align-items-start gap-3 mb-2">

                                <h3 class="hotel-name mb-0">
                                    @hotel.Name
                                </h3>

                                <div class="rating-badge">
                                    <i class="bi bi-star-fill"></i>
                                    <span>@hotel.Rating</span>
                                </div>

                            </div>

                            <p class="hotel-description">
                                @hotel.Description
                            </p>

                            <div class="hotel-divider"></div>

                            <!-- Card Footer -->
                            <div class="d-flex justify-content-between
                                        align-items-center gap-2 mt-auto">

                                <div class="hotel-meta">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Comfortable stay
                                </div>

                                <a asp-page="/Hotels/Details" asp-Route-hotelId="@hotel.Id"

                                   class="hotel-button">
                                    View Details
                                    <i class="bi bi-arrow-up-right ms-2"></i>
                                </a>

                            </div>
                          
                        </div>

                    </article>

                </div>
            }

        </div>

        @if (!Model.Hotels.Any())
        {
            <div class="empty-hotels text-center py-5">
                <i class="bi bi-buildings empty-icon"></i>
                <h3 class="mt-3">No hotels available yet</h3>
                <p class="text-secondary">
                    Please check back later for available properties.
                </p>
            </div>
        }

    </div>
</section>


@* why choose US  *@

<div style=" background: linear-gradient(135deg, #00126a, #2E86C1);" class="py-5 mt-5">
    <div class="container text-white text-center">
        <h2 class="fw-bold mb-5">Why Choose Us</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <i class="bi bi-shield-check fs-1 text-warning"></i>
                <h4 class="mt-3">Secure Booking</h4>
                <p class="text-white-50">Your bookings are safe and protected.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-cash-coin fs-1 text-warning"></i>
                <h4 class="mt-3">Best Prices</h4>
                <p class="text-white-50">We offer the best rates guaranteed.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-headset fs-1 text-warning"></i>
